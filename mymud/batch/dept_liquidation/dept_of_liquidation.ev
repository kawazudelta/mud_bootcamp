# Department of Liquidation - Batch File
# Builder: Fargo
#
# --- PHASE 1: CREATE ROOMS ---
#
@create/drop The Waiting Room;liquidation_waiting:typeclasses.rooms.Room
#
@create/drop Corridor A;liquidation_corr_a:typeclasses.rooms.Room
#
@create/drop The Break Room;liquidation_break:typeclasses.rooms.Room
#
@create/drop Corridor B;liquidation_corr_b:typeclasses.simple_adventure.AdventureWeatherRoom
#
@create/drop The Cubicle Farm;liquidation_cubicles:typeclasses.simple_adventure.AdventureTeleportRoom
#
@create/drop The Server Closet;liquidation_server:typeclasses.simple_adventure.AdventureDarkRoom
#
@create/drop Ventilation Shaft;liquidation_vent:typeclasses.simple_adventure.BridgeRoom
#
@create/drop Executive Antechamber;liquidation_ante:typeclasses.rooms.Room
#
@create/drop The Manager's Office;liquidation_office:typeclasses.rooms.Room
#
@create/drop The Fire Escape;liquidation_exit:typeclasses.rooms.Room
#

# --- PHASE 2: DESCRIBE ROOMS ---
#
@desc The Waiting Room = A beige room with a low, water-stained ceiling. A plastic fern sits in the corner, gathering dust. The air smells like ozone and despair.
#
@desc Corridor A = An endless stretch of gray carpet and flickering lights. The walls are a calming, oppressive shade of eggshell.
#
@desc The Break Room = The kitchenette. A coffee pot contains a tar-like substance that might have been liquid once.
#
@desc Corridor B = The hallway continues, but the carpet here is sodden and squelches underfoot.
#
@desc The Cubicle Farm = A maze of gray fabric walls. You can hear typing, but there is no one here.
#
@desc The Server Closet = Pitch black. You can hear the hum of a thousand cooling fans.
#
@desc Ventilation Shaft = A cramped, dusty tunnel. The plastic ductwork groans under your weight.
#
@desc Executive Antechamber = The carpet here is slightly plushier. A heavy oak door looms ahead.
#
@desc The Manager's Office = A massive desk dominates the room. Behind it, a window looks out onto... nothing but static.
#
@desc The Fire Escape = A rusty metal platform hanging over a void.
#

# --- PHASE 3: DECORATE ROOMS & CONFIGURE FEATURES ---
#
# 3.1 Readable Object (Waiting Room)
@tel The Waiting Room
#
@create/drop Sticky Note;liquidation_note:typeclasses.simple_adventure.AdventureReadable
#
@desc Sticky Note = A yellow square stuck to the wall.
#
@set Sticky Note/readable_text = "THE BEATINGS WILL CONTINUE UNTIL MORALE IMPROVES. ALSO, THE COFFEE MACHINE IS A MIMIC. - MGMT"
#
@lock Sticky Note = get:false()
#
# 3.2 Climbable Object (Corridor A)
@tel Corridor A
#
@create/drop Teetering File Cabinet;liquidation_cabinet:typeclasses.simple_adventure.AdventureClimbable
#
@desc Teetering File Cabinet = A tower of metal drawers, rusted shut. It looks like it could be used as a ladder.
#
@set Teetering File Cabinet/climb_msg = You scramble up the rusting metal. Near the ceiling, you spot a loose grate!
#
@lock Teetering File Cabinet = get:false()
#
# 3.3 Weapon Rack (Break Room)
@tel The Break Room
#
@create/drop Lost & Found Box;liquidation_box:typeclasses.simple_adventure.TutorialWeaponRack
#
@desc Lost & Found Box = A cardboard box labeled 'DO NOT TOUCH' in Sharpie. It smells like old pennies.
#
@set Lost & Found Box/rack_id = "liquidation_box_1"
#
@set Lost & Found Box/available_weapons = ["plastic sword", "stapler"]
#
@set Lost & Found Box/no_more_weapons_msg = The box is empty. Someone stole the good stuff.
#
@lock Lost & Found Box = get:false()
#
# 3.4 Light Source (Break Room)
# (Placing it here so the player can take it for the Dark Room)
@create/drop Glow Stick;liquidation_glow:typeclasses.simple_adventure.AdventureLightSource
#
@desc Glow Stick = A cracked chemical light. It hums aggressively.
#
# 3.5 Weather Room Config (Corridor B)
@tel Corridor B
#
@set here/weather_msgs = ["Oily water drips onto your neck.", "The carpet squelches loudly.", "A ceiling tile dissolves into gray mush."]
#
# 3.6 Teleport Puzzle (Cubicle Farm)
@tel The Cubicle Farm
#
@set here/puzzle_key = "Employee ID Card"
#
@set here/target_success = "liquidation_ante"
#
@set here/target_failure = "liquidation_waiting"
#
@set here/msg_success = The scanner beeps happily. Allowed.
#
@set here/msg_failure = SECURITY ALERT. UNAUTHORIZED PERSONNEL. WHOOSH.
#
# (Need to give the player the key somewhere? Let's hide it in the Server Closet)
#
# 3.7 Dark Room & Loot (Server Closet)
@tel The Server Closet
#
@create/drop Employee ID Card;liquidation_id_card:typeclasses.objects.Object
#
@desc Employee ID Card = A plastic badge. The photo is just a blur.
#
# 3.8 Bridge Room Config (Ventilation Shaft)
@tel Ventilation Shaft
#
@set here/west_exit = "liquidation_server"
#
@set here/east_exit = "liquidation_ante"
#
@set here/fall_exit = "liquidation_cubicles"
#
@set here/fall_msg = The plastic cracks! You tumble down into the maze!
#
# 3.9 Active Mob (Executive Antechamber)
@tel Executive Antechamber
#
@create/drop The Shift Supervisor;liquidation_boss:typeclasses.simple_adventure.AdventurePatrolMob
#
@sethome The Shift Supervisor = Executive Antechamber
#
@set The Shift Supervisor/patrolling = True
#
@set The Shift Supervisor/aggressive = True
#
@set The Shift Supervisor/desc_alive = A suit of armor made of recycled printer parts. It has no face.
#
@set The Shift Supervisor/desc_dead = A pile of scrap metal and toner cartridges.
#
# Give the mob a weapon
@create/drop Red Tape;liquidation_whip:typeclasses.simple_adventure.TutorialWeapon
#
@tel/quiet Red Tape = The Shift Supervisor
#
mobon The Shift Supervisor
#

# --- PHASE 4: LINK ROOMS ---
#
@tel The Waiting Room
#
@open north;n = Corridor A
#
@tel Corridor A
#
@open south;s = The Waiting Room
#
@open east;e = The Break Room
#
@open west;w = Corridor B
#
# (Hidden Exit from Corridor A to Server Closet)
@open vent;up = The Server Closet
#
# Lock the vent so you have to climb the cabinet first.
# AdventureClimbable sets a tag "climbed_<object_id>".
# Since we don't know the ID yet, we'll assume the player just climbs it.
# For now, let's just make the exit visible but locked? Or just open.
# The previous logic relied on "tutorial_climbed_tree".
# Let's just leave it unlocked for now to ensure connectivity, or lock to a generic tag.
# @lock vent = view:tag(climbed_cabinet, tutorial);traverse:tag(climbed_cabinet, tutorial)
#
@tel The Break Room
#
@open west;w = Corridor A
#
@tel Corridor B
#
@open east;e = Corridor A
#
@open north;n = The Cubicle Farm
#
@tel The Cubicle Farm
#
@open south;s = Corridor B
#
@open north;n = Executive Antechamber
#
@tel The Server Closet
#
@open down;d = Corridor A
#
@open north;n = Ventilation Shaft
#
@tel Ventilation Shaft
#
@open south;s = The Server Closet
#
@open north;n = Executive Antechamber
#
@tel Executive Antechamber
#
@open south;s = The Cubicle Farm
#
@open north;n = The Manager's Office
#
@tel The Manager's Office
#
@open south;s = Executive Antechamber
#
@open out;exit = The Fire Escape
#
@tel The Fire Escape
#
@open in = The Manager's Office
#